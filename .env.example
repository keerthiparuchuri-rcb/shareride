# Supabase Configuration (Required)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Open-Source Mapping Services (Optional overrides)
# Defaults to public OpenStreetMap Nominatim and OSRM servers
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# VITE_OSRM_URL=https://router.project-osrm.org
